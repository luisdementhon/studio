# Variables d'environnement requises par Dotly.
# Copier en .env.local et renseigner les valeurs (.env* est gitignoré).
# Ne jamais committer de valeurs réelles.

# --- Bridge (open banking, AISP) ---
# Dashboard Bridge > vos identifiants d'application
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
# Secret de signature généré à la création du webhook dans le dashboard Bridge.
# Distinct du client secret. Sans lui, /api/bridge/webhook rejette tout appel.
BRIDGE_WEBHOOK_SECRET=

# --- Stripe ---
# Dashboard Stripe > Développeurs > Clés API
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Dashboard Stripe > Développeurs > Webhooks > votre endpoint > Secret de signature
# (commence par whsec_). Sans lui, /api/stripe/webhook répond 500.
STRIPE_WEBHOOK_SECRET=

# --- Jobs planifiés (Cloud Scheduler) ---
# Secret partagé protégeant /api/cron/*. À générer aléatoirement,
# par exemple : openssl rand -hex 32
CRON_SECRET=

# --- Commission ---
# Pourcentage prélevé par dotly sur les dons. Défaut : 15.
PLATFORM_FEE_PERCENT=15

# --- Emails transactionnels (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="dotly <bonjour@dotly-app.fr>"
