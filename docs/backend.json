{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Dotly application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "firstName": {
          "type": "string",
          "description": "User's first name."
        },
        "lastName": {
          "type": "string",
          "description": "User's last name."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "causes": {
          "type": "array",
          "description": "List of causes the user is interested in supporting.",
          "items": {
            "type": "string"
          }
        },
        "donationMultiplier": {
          "type": "number",
          "description": "Multiplier applied to donations."
        },
        "donationCeiling": {
          "type": "number",
          "description": "Maximum amount a user will donate in a given period."
        },
        "bankConnected": {
          "type": "boolean"
        },
        "bankName": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "email"
      ]
    },
    "Association": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Association",
      "type": "object",
      "description": "Represents an association using the Dotly application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Association entity."
        },
        "associationName": {
          "type": "string",
          "description": "Name of the association."
        },
        "representativeName": {
          "type": "string",
          "description": "Name of the association's representative."
        },
        "contactEmail": {
          "type": "string",
          "format": "email"
        },
        "rnaNumber": {
          "type": "string",
          "description": "Association's RNA number."
        },
        "description": {
          "type": "string"
        },
        "fundraisingGoal": {
          "type": "number"
        },
        "currentMissions": {
          "type": "string"
        },
        "stripeAccountId": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "associationName",
        "representativeName",
        "contactEmail",
        "rnaNumber"
      ]
    },
    "Donation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Donation",
      "type": "object",
      "description": "Represents a donation made through the Dotly application.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "associationId": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "transactionDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "associationId",
        "amount",
        "transactionDate"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            }
          ]
        }
      },
      {
        "path": "/associations/{associationId}",
        "definition": {
          "entityName": "Association",
          "schema": {
            "$ref": "#/backend/entities/Association"
          },
          "description": "Stores association profiles.",
          "params": [
            {
              "name": "associationId",
              "description": "The unique identifier of the association."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/donations/{donationId}",
        "definition": {
          "entityName": "Donation",
          "schema": {
            "$ref": "#/backend/entities/Donation"
          },
          "description": "Stores the private donation records for a user.",
          "params": [
            {
              "name": "userId",
              "description": "The UID of the user."
            },
            {
              "name": "donationId",
              "description": "The UID of the donation."
            }
          ]
        }
      },
      {
        "path": "/associations/{associationId}/donations/{donationId}",
        "definition": {
          "entityName": "Donation",
          "schema": {
            "$ref": "#/backend/entities/Donation"
          },
          "description": "Stores a record of a donation for the recipient association.",
          "params": [
            {
              "name": "associationId",
              "description": "The UID of the association."
            },
            {
              "name": "donationId",
              "description": "The UID of the donation."
            }
          ]
        }
      }
    ]
  }
}