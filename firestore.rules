/**
 * @fileoverview Firestore Security Rules for the Dotly application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and transactions,
 * while allowing public read access to association and cause data. Donations are publicly accessible,
 * but creating, updating, and deleting them is not allowed in this prototype.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the authenticated user.
 * - /associations/{associationId}: Stores association profiles, publicly readable.
 * - /users/{userId}/transactions/{transactionId}: Stores user transactions, accessible only by the authenticated user.
 * - /causes/{causeId}: Stores causes, globally accessible.
 * - /donations/{donationId}: Stores donation data with denormalized userId and associationId to enable simple security rules, publicly readable.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent data leakage.
 * - Association and cause data are publicly readable.
 * - Donations are publicly readable, but writes are disallowed during prototyping.
 * - Strict ownership is enforced for user profiles and transactions.
 *
 * Denormalization for Authorization:
 * - Donations include `userId` and `associationId` to enable filtering and reporting without additional `get()` calls in the rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces document ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get, update, delete) Authenticated user 'user123' can access their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     * @deny (get, update, delete) User 'user456' cannot access user 'user123' profile.
     * @principle Enforces document ownership and authenticates identity.
     */
    match /users/{userId} {
      allow get, update: if isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows public read access to association profiles, but write access is restricted to the owner.
     * @path /associations/{associationId}
     * @allow (get, list) Any user can read association profiles.
     * @allow (create, update, delete) Only the authenticated user who owns the document can modify it.
     * @principle Allows public read access while restricting write access to the owner.
     */
    match /associations/{associationId} {
      allow get, list: if true;
      allow create, update, delete: if isOwner(associationId);
    }

    /**
     * @description Enforces document ownership for user transactions.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) User with ID 'user123' can create a transaction.
     * @allow (get, list, update, delete) Authenticated user 'user123' can access their own transactions.
     * @deny (create) User with ID 'user456' cannot create a transaction for 'user123'.
     * @deny (get, list, update, delete) User 'user456' cannot access user 'user123' transactions.
     * @principle Enforces document ownership and authenticates identity.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId; //Enforce immutability for userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to causes.
     * @path /causes/{causeId}
     * @allow (get, list) Any user can read causes.
     * @deny (create, update, delete) No user can create, update, or delete causes.
     * @principle Allows public read access while restricting write access.
     */
    match /causes/{causeId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to donations.  Write access is disabled in the prototype.
     * @path /donations/{donationId}
     * @allow (get, list) Any user can read donations.
     * @deny (create, update, delete) No user can create, update, or delete donations.
     * @principle Allows public read access while restricting write access during the prototype phase.
     */
    match /donations/{donationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}
