/**
 * This ruleset enforces a security model for the Dotly application with a focus
 * on strict user data privacy and public discoverability for associations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // -------------------------------------------------------------------------
    // User Profiles (/users/{userId})
    //
    // Le document utilisateur pilote directement le prélèvement : il porte le
    // plafond du mandat, les identifiants Stripe et le lien Bridge. Autoriser
    // le client à écrire n'importe lequel de ses champs reviendrait à le
    // laisser relever son propre plafond, ou désigner la carte d'un tiers.
    //
    // Ces champs-là sont donc réservés au serveur (Admin SDK, qui contourne
    // ces règles). Le client ne peut écrire que ses préférences.
    // -------------------------------------------------------------------------
    function serverOwnedUserFields() {
      return [
        'stripeCustomerId', 'stripePaymentMethodId', 'stripeSetupIntentId',
        'cardBrand', 'cardLast4', 'paymentMethodLinked',
        'mandateSignedAt', 'mandateCeiling', 'mandateNeedsReauth',
        'roundupRotationIndex', 'bankDisconnectedAt',
        'bankConnected', 'bankName', 'bridgeItemId', 'bridgeUserUuid', 'connectedAt',
        'consentedAt', 'consentVersion', 'welcomeEmailSentAt'
      ];
    }

    // Aucun champ réservé ne doit être ajouté ni modifié par cette écriture.
    function keepsServerFields() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(serverOwnedUserFields().toSet());
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
                    && request.resource.data.id == userId
                    && !request.resource.data.keys().toSet().hasAny(serverOwnedUserFields().toSet());
      allow update: if isExistingOwner(userId)
                    && request.resource.data.id == resource.data.id
                    && keepsServerFields();
      allow delete: if isExistingOwner(userId);
    }

    // -------------------------------------------------------------------------
    // User Donations (/users/{userId}/donations/{donationId})
    // Written server-side only (webhooks, Admin SDK bypasses these rules).
    // Clients must never be able to fabricate a donation record.
    // -------------------------------------------------------------------------
    match /users/{userId}/donations/{donationId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Associations (/associations/{associationId})
    // -------------------------------------------------------------------------
    match /associations/{associationId} {
      // Les profils sont lisibles par tout le monde pour permettre la découverte.
      allow get, list: if true;
      
      // Création et mise à jour passent par /api/association/register, qui
      // vérifie le RNA côté serveur. Une écriture directe depuis le client
      // permettrait de se déclarer « vérifiée » sans l'être.
      allow write: if false;
    }
    
    // -------------------------------------------------------------------------
    // Association Donations (/associations/{associationId}/donations/{donationId})
    // -------------------------------------------------------------------------
    match /associations/{associationId}/donations/{donationId} {
      allow read: if isOwner(associationId);
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Association Financials (/associations/{associationId}/payouts/{payoutId})
    // -------------------------------------------------------------------------
    match /associations/{associationId}/payouts/{payoutId} {
      allow read: if isOwner(associationId);
    }

    match /associations/{associationId}/taxReceipts/{receiptId} {
      allow read: if isOwner(associationId);
    }

    // -------------------------------------------------------------------------
    // Collections d'orchestration (batches de prélèvement, exécutions du cron,
    // registre d'idempotence Stripe).
    //
    // Écrites exclusivement par le serveur via l'Admin SDK, qui contourne ces
    // règles. Aucun accès client : elles portent l'état financier.
    // -------------------------------------------------------------------------
    match /monthly_batches/{batchId} {
      allow read, write: if false;
    }

    match /settlement_runs/{runId} {
      allow read, write: if false;
    }

    match /settlement_failures/{failureId} {
      allow read, write: if false;
    }

    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    // Échecs de prélèvement : le donateur peut consulter les siens.
    match /users/{userId}/payment_failures/{failureId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
  }
}