/**
 * This ruleset enforces a security model for the Dotly application with a focus
 * on strict user data privacy and public discoverability for associations.
 *
 * Core Philosophy:
 * The rules establish a strong user-ownership model, where each user has
 * exclusive control over their personal data and associated records like donations.
 * Data intended for public consumption is explicitly separated into its own
 * top-level collection.
 *
 * Data Structure:
 * - /users/{userId}: Contains private user profile information. All subcollections
 *   inherit the ownership model of this parent document.
 * - /users/{userId}/donations/{donationId}: Stores donation records, which are
 *   private to the user who made them.
 * - /associations/{associationId}: A top-level collection for association profiles,
 *   which are publicly readable to facilitate discovery within the app.
 *
 * Key Security Decisions:
 * - Strict User Data Segregation: A user can ONLY access documents within their
 *   own data tree (e.g., /users/their-own-id/...).
 * - No User Listing: To protect user privacy, it is impossible for any client
 *   to list the documents in the top-level `/users` collection.
 * - Public Read-Only for Associations: Association data is public for any client
 *   to read, but all write operations are disabled by default until a secure
 *   ownership or admin model is defined in the application's data schema.
 * - Denormalization for Authorization: User and association IDs are stored directly
 *   on donation documents. This avoids costly and slow `get()` calls in rules,
 *   allowing for fast and simple ownership checks based on the document path.
 *
 * Prototyping Mode:
 * These rules enforce strict authorization (who can access what) but remain
 * flexible on data shapes. They do not validate specific fields or data types,
 * allowing for rapid front-end development and iteration. The only data
 * validation performed is on fields critical for maintaining relational integrity,
 * such as ensuring a document's internal owner ID matches the ID in its path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's ID matches the provided userId.
     * This is the primary function for enforcing data ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the document exists AND the authenticated user is the owner.
     * Used for safe update and delete operations to prevent modifying non-existent data.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * On create, validates that the user is setting their own UID as the document's ID.
     * This establishes the ownership link and maintains data consistency.
     */
    function isCreatingOwnUserDocument(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * On update, ensures the document's unique ID (which links to the user) cannot be changed.
     */
    function isUserIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * On create, validates that the donation's internal userId matches the user's path.
     * This ensures donations are correctly associated with the creator.
     */
    function hasCorrectDonationOwner(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * On update, ensures the donation's owner link (userId) cannot be changed.
     */
    function isDonationOwnerImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }


    // -------------------------------------------------------------------------
    // User Profiles (/users/{userId})
    // -------------------------------------------------------------------------

    /**
     * @description Controls access to user profile documents. A user can create, read,
     *   update, and delete their own profile, but cannot see or list others.
     * @path /users/{userId}
     * @allow (get) A logged-in user with uid 'user123' retrieving '/users/user123'.
     * @deny (get) A logged-in user with uid 'user456' retrieving '/users/user123'.
     * @deny (list) Any user attempting to list the '/users' collection.
     * @principle Restricts access to a user's own data tree, preventing data leakage.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isCreatingOwnUserDocument(userId);
      allow update: if isExistingOwner(userId) && isUserIdImmutable();
      allow delete: if isExistingOwner(userId);
    }


    // -------------------------------------------------------------------------
    // User Donations (/users/{userId}/donations/{donationId})
    // -------------------------------------------------------------------------

    /**
     * @description Manages access to donation records, which are stored in a subcollection
     *   under the user who created them.
     * @path /users/{userId}/donations/{donationId}
     * @allow (create) User 'user123' creating a donation at '/users/user123/donations/don456'.
     * @allow (list) User 'user123' listing their own donations at '/users/user123/donations'.
     * @deny (get) User 'user456' trying to read a donation at '/users/user123/donations/don456'.
     * @principle Enforces document ownership for all operations based on the URL path.
     */
    match /users/{userId}/donations/{donationId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && hasCorrectDonationOwner(userId);
      allow update: if isExistingOwner(userId) && isDonationOwnerImmutable();
      allow delete: if isExistingOwner(userId);
    }


    // -------------------------------------------------------------------------
    // Associations (/associations/{associationId})
    // -------------------------------------------------------------------------

    /**
     * @description Manages public profiles for associations. This data is intended
     *   for public discovery, so all reads are permitted. Writes are disabled.
     * @path /associations/{associationId}
     * @allow (get, list) Any user, signed in or not, reading association data.
     * @deny (create, update, delete) Any user attempting to modify association data.
     * @principle Provides public read access while defaulting to a secure "deny all"
     *   posture for writes until a proper admin/ownership model is implemented.
     */
    match /associations/{associationId} {
      allow get, list: if true;
      // CRITICAL: Cannot implement owner-only writes. The 'Association' entity is missing an 'ownerId' or 'creatorId' field.
      // Writes are disabled for security. Update schema and rules to enable.
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}